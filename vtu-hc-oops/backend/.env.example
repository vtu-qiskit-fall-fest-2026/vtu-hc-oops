PORT=5000

# Leave MONGODB_URI empty to run in demo mode: an in-memory MongoDB is started and
# seeded with demo accounts (see README). Set it to a real URI to keep data.
MONGODB_URI=
# Required with a real database. In demo mode a random secret is generated per run.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Deployed frontend origin(s), comma-separated, e.g. https://loadsetu.vercel.app (CORS + e-mail links)
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Maps and road routing. Without a key the keyless OSRM demo server + Nominatim are used
# (car profile, fair-use limits). A free OpenRouteService key gives truck (HGV) routing:
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Fuel / CO2 estimate inputs (defaults: 4 km per litre, Rs 90 per litre of diesel).
TRUCK_KM_PER_LITRE=
DIESEL_RUPEES_PER_LITRE=

# Python QAOA service (quantum/). Default http://127.0.0.1:8000
QUANTUM_SERVICE_URL=
# Shared secret; set the same value as QUANTUM_SERVICE_KEY on the quantum service. Empty = no check.
QUANTUM_SERVICE_KEY=

# Optional delay-prediction model service
LOADSETU_DELAY_MODEL_URL=
LOADSETU_DELAY_MODEL_API_KEY=

# Razorpay test keys (subscriptions). Not needed in demo mode: demo accounts are pre-subscribed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
